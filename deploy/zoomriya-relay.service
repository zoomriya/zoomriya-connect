# /etc/systemd/system/zoomriya-relay.service
[Unit]
Description=ZOOMRIYA Connect relay
Documentation=https://github.com/zoomriya/zoomriya-connect/blob/main/docs/operations.md
Wants=network-online.target
After=network-online.target

[Service]
User=zoomriya-connect
Group=zoomriya-connect
ExecStart=/usr/local/bin/zoomriya-relay run --config /etc/zoomriya-relay/relay.toml
Restart=always
RestartSec=2
StateDirectory=zoomriya-relay
StateDirectoryMode=0700
ConfigurationDirectory=zoomriya-relay
# Ports 80 and 443, and nothing else a root process could do.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
