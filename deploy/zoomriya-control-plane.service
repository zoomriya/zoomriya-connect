# /etc/systemd/system/zoomriya-control-plane.service
[Unit]
Description=ZOOMRIYA Connect control plane
Documentation=https://github.com/zoomriya/zoomriya-connect/blob/main/docs/operations.md
Wants=network-online.target
After=network-online.target

[Service]
User=zoomriya-connect
Group=zoomriya-connect
ExecStart=/usr/local/bin/zoomriya-control-plane run --config /etc/zoomriya-control-plane/control-plane.toml
Restart=always
RestartSec=2
StateDirectory=zoomriya-control-plane
StateDirectoryMode=0700
ConfigurationDirectory=zoomriya-control-plane
# Ports 53 and 443, and nothing else a root process could do.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
