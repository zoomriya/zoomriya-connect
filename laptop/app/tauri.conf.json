{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZOOMRIYA Connect",
  "identifier": "com.zoomriya.laptop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32.png", "icons/128.png"]
  }
}
